    FOOD_ITEMS ||--o{ ORDER_ITEMS : "ordered as"

    ORDERS ||--|{ ORDER_ITEMS : contains
    ORDERS ||--o| PAYMENTS : "settled by"
    DELIVERY_AGENTS ||--o{ ORDERS : delivers

